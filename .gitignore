# 数据、产物、权重放在 $HA_DATA、$HA_OUTPUTS 指向的目录，不进 Git
data/
datasets/
outputs/
runs/
logs/
caches/
checkpoints/
*.zip
*.tar
*.tar.gz
*.usd
*.usda
*.usdc
*.usdz
*.glb
# 例外：网页演示用的 H1 住宅模型（许可见 web/models/H1/LICENSE.md）
!web/models/H1/*.glb
# 例外：素材库里替换方案用到的家具模型（说明见 web/library/LICENSE.md）
!web/library/models/*.glb
# 例外：实验室户型的展示模型（许可见 web/lab/LICENSE.md）
!web/lab/*/*.glb
*.ply
*.spz
*.pt
*.pth
*.ckpt

# 论文原件和外部手册只留本地
docs/papers/*.pdf
docs/*.pdf

# 视频、演示文稿原件放 $HA_OUTPUTS/deliveries
*.mp4
*.mov
*.pptx
*.key

# 凭证
.env
*.env
private/

# Python / Node / 编辑器
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
node_modules/
.DS_Store
