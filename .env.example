# 复制为 .env 后填写（.env 已 gitignore，不要提交）。加载：set -a; . ./.env; set +a
# 路径用绝对路径。

# 数据根目录，下面放 World-SimReady-Home/、SAGE-10k/（见 docs/tech/data.md §2）
HA_DATA=/path/to/datasets

# 产物根目录（runs/、assets/、deliveries/）。留空时用仓库内 outputs/（已 gitignore）
HA_OUTPUTS=

# 仓库根目录，只用来拼下面的 PYTHONPATH
HA_REPO=/path/to/home-accessibility

# 让 python 找到 src/ha
PYTHONPATH=${HA_REPO}/src

# Hugging Face token：下载 WSR（gated，每人用自己的账号申请）
HF_TOKEN=

# LLM 端点。不填时决策层和独白走规则版
# HA_LLM_PROTOCOL：openai（Chat Completions，DeepSeek、通义、豆包、Kimi、vLLM 等）或 anthropic（Claude Messages）
HA_LLM_PROTOCOL=openai
HA_LLM_BASE_URL=
HA_LLM_TOKEN=
HA_LLM_MODEL=

# Aholo / Lux3D key。付费 create 前必须在群里确认
AHOLO_API_KEY=
